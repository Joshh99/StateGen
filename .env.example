# Copy this file to .env and fill in your own key.
# Load with:  set -a && source .env && set +a
# Never commit .env to git.

# ── DeepSeek (default — main experiments) ────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_key_here
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-coder
LLM_BASE_URL=https://api.deepseek.com/v1

# ── CMU Andrew Gateway (free — cross-model experiments) ───────────────────────
# Uncomment to activate. Pass key via --api_key $CMU_API_KEY at runtime.
# Run command:
#   python experiments/run_bigcodebench.py \
#     --method stategen_no_memory \
#     --provider openai_compatible \
#     --model gpt-4o-mini \
#     --base_url https://ai-gateway.andrew.cmu.edu/ \
#     --api_key $CMU_API_KEY \
#     --results_dir results/gpt4omini/
#
# CMU_API_KEY=your_andrew_gateway_key_here

# ── Matplotlib fix (required on macOS) ───────────────────────────────────────
MPLBACKEND=Agg
